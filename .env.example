PORT=5000

# App conecta como papel NOSUPERUSER (RLS é ignorado por superusuário).
# Crie o papel com scripts/setup-rls-role.sql antes de subir.
DATABASE_URL="postgresql://troca_aula_app:app_password_local@localhost:5432/troca_aula?schema=public"

# Papel dono/superusuário, usado SÓ por `pnpm db:migrate` (DDL).
# Sem esta variável, o migrate cai de volta para DATABASE_URL.
MIGRATION_DATABASE_URL="postgresql://my_user:my_password@localhost:5432/troca_aula?schema=public"

SECRET="s0//P4$$w0rD"
SALT=10

# Notificações por e-mail (opcional) — sem SMTP_HOST, o EmailService vira
# no-op e nada quebra em dev/CI.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=senha
# SMTP_FROM="Troca Aula <no-reply@exemplo.com>"
